{
  "name": "local-change-groups",
  "displayName": "Local Change Groups",
  "description": "Privately organize Git changes in a read-only Source Control view.",
  "version": "0.1.0",
  "publisher": "sherryabdulqader",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onView:localChangeGroups.view"
  ],
  "main": "./out/src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "localChangeGroups.createGroup",
        "title": "Local Change Groups: Create Group",
        "icon": "$(add)"
      },
      {
        "command": "localChangeGroups.renameGroup",
        "title": "Local Change Groups: Rename Group"
      },
      {
        "command": "localChangeGroups.deleteGroup",
        "title": "Local Change Groups: Delete Group"
      },
      {
        "command": "localChangeGroups.assignToGroup",
        "title": "Local Change Groups: Assign or Move File"
      },
      {
        "command": "localChangeGroups.removeFromGroup",
        "title": "Local Change Groups: Remove File from Group"
      },
      {
        "command": "localChangeGroups.refresh",
        "title": "Local Change Groups: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "localChangeGroups.openChange",
        "title": "Local Change Groups: Open Change"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "localChangeGroups.view",
          "name": "Local Change Groups"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "localChangeGroups.createGroup",
          "when": "view == localChangeGroups.view",
          "group": "navigation@1"
        },
        {
          "command": "localChangeGroups.refresh",
          "when": "view == localChangeGroups.view",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "localChangeGroups.renameGroup",
          "when": "view == localChangeGroups.view && viewItem == localChangeGroups.group",
          "group": "inline@1"
        },
        {
          "command": "localChangeGroups.deleteGroup",
          "when": "view == localChangeGroups.view && viewItem == localChangeGroups.group",
          "group": "inline@2"
        },
        {
          "command": "localChangeGroups.assignToGroup",
          "when": "view == localChangeGroups.view && viewItem =~ /localChangeGroups\\.file/",
          "group": "inline@1"
        },
        {
          "command": "localChangeGroups.removeFromGroup",
          "when": "view == localChangeGroups.view && viewItem == localChangeGroups.file.grouped",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.2"
  }
}
